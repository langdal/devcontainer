#!/usr/bin/env bash
set -euo pipefail

# Released version of the dev script. Bumped automatically by release-please
# (see release-please-config.json's `extra-files` entry); do not edit the
# version literal by hand — touch the marker comment if reformatting.
VERSION="2.2.0" # x-release-please-version

# Display version. Prefers `git describe` when SCRIPT_DIR is a git checkout
# so a branch ahead of the latest tag reports e.g. `v1.0.0-rc.1-3-g5b7cdf5`
# (or `…-dirty`) instead of lying with the stale literal. Falls back to the
# release-please–managed $VERSION literal when there is no git checkout
# (image-baked installs, copied script, etc.). Image build labels and the
# version-mismatch rebuild prompt still use $VERSION — those need a value
# that's stable across commits.
resolve_dev_version() {
  if command -v git >/dev/null 2>&1 && [[ -d "$SCRIPT_DIR/.git" ]]; then
    local described
    described=$(git -C "$SCRIPT_DIR" describe --tags --always --dirty 2>/dev/null || true)
    if [[ -n "$described" ]]; then
      printf '%s\n' "$described"
      return
    fi
  fi
  printf '%s\n' "$VERSION"
}

# Resolve the real directory of this script, following symlinks.
# Needed so --build finds the Dockerfile when invoked via an installed symlink.
resolve_script_dir() {
  local source="${BASH_SOURCE[0]}"
  while [[ -L "$source" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  cd -P "$(dirname "$source")" && pwd
}
SCRIPT_DIR="$(resolve_script_dir)"

# Source the dev modules. Split out of this file for readability; they are
# plain function-definition files (no side effects at source time). They live
# next to this script and are found via the symlink-resolved SCRIPT_DIR, so a
# `dev install` symlink on PATH still locates them.
for _mod in "$SCRIPT_DIR"/lib/dev/*.sh; do
  # The glob is literal if the dir is empty/missing; guard so we never source '*.sh'.
  [[ -e "$_mod" ]] || continue
  # shellcheck source=/dev/null
  . "$_mod"
done
unset _mod

# The modules above define the bulk of dev's logic. If lib/dev/ is missing
# (e.g. someone copied only the dev script), fail early with a clear message
# rather than a cryptic "command not found" mid-run.
if ! declare -F start_container >/dev/null 2>&1; then
  echo "Error: dev's lib/dev/ modules were not found next to the script (looked in $SCRIPT_DIR/lib/dev/)." >&2
  echo "       dev requires a full checkout, not just the dev file. See install.sh / the README." >&2
  exit 1
fi

# Container-runtime extra args. On macOS+podman, the rootless connection
# cannot pass /dev/net/tun into a container (rootless podman silently drops
# the device even with --device=/dev/net/tun), which makes the nested
# rootless dockerd's slirp4netns fail. Route --dind through the rootful
# podman connection instead. dind containers, images, and volumes live in
# the rootful storage; everything else stays rootless.
#
#   DIND_RUNTIME_ARGS — connection args to reach the dind storage from
#                       any mode (used by cross-context conflict guards).
#   RUNTIME_ARGS      — connection args for this invocation's primary
#                       target. Empty for normal/maint, set to
#                       DIND_RUNTIME_ARGS for --dind.
# shellcheck disable=SC2034  # set/read by _resolve_workspace_names + the lib/dev/* runtime calls
DIND_RUNTIME_ARGS=""
# shellcheck disable=SC2034  # set/read by cmd_start (lib/dev/up.sh) and every lib/dev/* runtime call
RUNTIME_ARGS=""

# shellcheck disable=SC2034  # consumed by cmd_start (lib/dev/up.sh) and resolve_agent_storage (lib/dev/inject.sh)
IMAGE_NAME="generic-devcontainer"

# Start-flow defaults. All of these are set by cmd_start (lib/dev/up.sh) and
# read there and in the lib/dev/* helpers it calls, so shellcheck (which does
# not follow the module loader's glob) cannot see the uses from here.
# shellcheck disable=SC2034  # consumed by cmd_start/self_update/approve_project_allowlist and start_container
DRY_RUN=false
# Whether the current operation talks to the engine. Read by
# ensure_runtime_ready (lib/dev/runtime.sh); verbs that only read state or
# print a command leave it false.
# shellcheck disable=SC2034  # consumed by ensure_runtime_ready
NEEDS_ENGINE=false
# Set true by _prefer_podman_cli_for_podman_engine (lib/dev/runtime.sh) when
# it rewrites $RUNTIME from docker to podman mid-detect_runtime. Read by
# _chk_engine_cli_match (lib/dev/checks-catalog.sh), which otherwise only
# ever sees the post-switch state and would wrongly report agreement.
# shellcheck disable=SC2034  # consumed by _chk_engine_cli_match; set by _prefer_podman_cli_for_podman_engine
ENGINE_CLI_SWITCHED=false
# shellcheck disable=SC2034  # consumed by cmd_start in lib/dev/up.sh
FORCE_BUILD=false
# shellcheck disable=SC2034  # consumed by start_container in lib/dev/lifecycle.sh
DEFAULT_PORTS=false
# shellcheck disable=SC2034  # consumed by cmd_start, approve_project_allowlist and start_container
MAINTENANCE=false
# shellcheck disable=SC2034  # consumed by cmd_start/preflights and start_container
DIND=false
# shellcheck disable=SC2034  # consumed by cmd_start/preflights and start_container
PIND=false
# shellcheck disable=SC2034  # consumed by attach_existing_container in lib/dev/container.sh
SHELL_ONLY=false
# shellcheck disable=SC2034  # consumed by start_container in lib/dev/lifecycle.sh
EXTRA_PORTS=()
# shellcheck disable=SC2034  # consumed by start_container in lib/dev/lifecycle.sh
HOST_PORTS=()
# shellcheck disable=SC2034  # consumed by start_container/attach_existing_container (lib/dev/{lifecycle,container}.sh)
CMD_ARGS=()

# Egress mode for the container being started: open (default) or closed.
# Seeded from DEV_EGRESS in cmd_start, overridable there by --open/--closed;
# passed to the container as DEVCONTAINER_EGRESS by start_container.
# shellcheck disable=SC2034  # consumed by cmd_start (lib/dev/up.sh) and start_container (lib/dev/lifecycle.sh)
EGRESS_MODE=open

# Per-workspace host-side state (lib/dev/approval.sh): the state dir holding the
# approved project allowlist + the GITHUB_TOKEN scope cache, and whether that
# approved allowlist is current enough to mount into the container.
# shellcheck disable=SC2034  # set by ensure_state_dir, read by approve_project_allowlist/resolve_github_token/append_volume_mounts
STATE_DIR=""
# shellcheck disable=SC2034  # set by approve_project_allowlist, read by append_volume_mounts (lib/dev/volumes.sh)
MOUNT_PROJECT_ALLOWLIST=false

# Populated by check_image_uid_match's single `image inspect` call so that
# check_image_version_match doesn't need to re-inspect, and the build path
# below can skip a separate `images -q` probe.
# shellcheck disable=SC2034  # set in lib/dev/image.sh, read by cmd_start in lib/dev/up.sh
IMAGE_EXISTS=false
# shellcheck disable=SC2034  # set/read by check_image_uid_match/check_image_version_match in lib/dev/image.sh
IMAGE_VERSION=""

# --- Subcommand router ------------------------------------------------------
# First non-flag token selects a subcommand. Each subcommand parses only its
# own flags, so invalid cross-command combinations are simply unrepresentable
# — no companion guard. Nothing falls through: every cmd_* exits (or execs),
# and the shared start flow (cmd_start, lib/dev/up.sh) is reached only by an
# explicit call from cmd_up/cmd_exec/cmd_shell.
subcmd=""
case "${1:-}" in
  up|shell|exec|down|status|ls|list|fw|reset|update|install|agent|dotfile|dotfiles|doctor) subcmd="$1"; shift ;;
  --help)    usage; exit 0 ;;
  --version) echo "dev $(resolve_dev_version)"; exit 0 ;;
  '')
    usage
    exit 0
    ;;
  -*)
    echo "Error: unknown option: '$1'" >&2
    echo "Run 'dev --help' for usage information" >&2
    exit 2
    ;;
  *)
    echo "Error: unknown verb: '$1'" >&2
    echo "Run 'dev --help' for usage information" >&2
    exit 2
    ;;
esac

# Every arm below is a thin call into the verb's module; each cmd_* exits (or
# execs) on its own, so nothing falls through past this case.
case "$subcmd" in
  # ${BASH_SOURCE[0]} is dev's own path: cmd_install needs the file the PATH
  # symlink must point at, which BASH_SOURCE inside the module would not give.
  install)          cmd_install "${BASH_SOURCE[0]}" "$@" ;;
  update)           cmd_update "$@" ;;
  reset)            cmd_reset "$@" ;;
  down)             cmd_down "$@" ;;
  status)           cmd_status "$@" ;;
  ls|list)          cmd_ls "$@" ;;
  doctor)           cmd_doctor "$@" ;;
  up)               cmd_up "$@" ;;
  exec)             cmd_exec "$@" ;;
  shell)            cmd_shell "$@" ;;
  fw)               cmd_fw "$@" ;;
  agent)            cmd_agent "$@" ;;
  dotfile|dotfiles) cmd_dotfile "$@" ;;
esac
